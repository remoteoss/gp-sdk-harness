# Copy to .env and fill in. NEVER commit .env.
#
# Rule: only VITE_-prefixed variables reach the browser. Vite inlines them into
# the client bundle, so a secret with a VITE_ prefix is a published secret.
# Keep REMOTE_CLIENT_SECRET and REMOTE_PARTNER_API_TOKEN un-prefixed.

# Gateway. 'partners' or 'sandbox' only — the server refuses to start on
# anything else, including 'production'.
REMOTE_GATEWAY=partners

# OAuth client, enabled for the urn:ietf:params:oauth:grant-type:jwt-bearer
# grant ("vetted partners" only).
REMOTE_CLIENT_ID=
REMOTE_CLIENT_SECRET=

# Remote *user ID* of a company owner/admin — not an employment ID, not a slug.
# Look it up with: GET /v1/company-managers using REMOTE_PARTNER_API_TOKEN,
# then read user_id from the owner entry.
REMOTE_OWNER_USER_ID=

# ra_test_ customer API token generated in the GP SDK Harness company's own
# dashboard. Used only for setup chores and for the T6b / T8 rows of the bank
# matrix, where the endpoint declares CustomerAPIToken auth. Never used inside
# the flows under test.
REMOTE_PARTNER_API_TOKEN=

# Exposed to the browser on purpose — a company UUID is not a secret.
VITE_COMPANY_ID=

# 'proxy' (Mode B, default) or 'direct' (Mode A, the client-side experiment).
VITE_AUTH_MODE=proxy

# Must be true before /local/token/* will mint anything. Mode A only.
HARNESS_ALLOW_BROWSER_TOKENS=false
